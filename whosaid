<base>.speakers.txt (the speaker-labeled transcript). Diarization failure never
loses the plain transcript — it warns and the transcript stands on its own.

Nothing — audio, text, or embeddings — ever leaves the machine.
EOF
}

# ---- install -----------------------------------------------------------------
cmd_install() {
  local install_dir="${WHOSAID_INSTALL_DIR:-$HOME/.local/bin}"
  local destination="$install_dir/whosaid"
  local source="$REPO_DIR/whosaid"

  mkdir -p "$install_dir"
  if [[ -L "$destination" ]]; then
    local existing=""
    existing="$(readlink "$destination" 2>/dev/null || true)"
    if [[ "$existing" == "$source" ]]; then
      log "✓ command already installed at $destination"
    else
      ln -sfn "$source" "$destination"
      log "✓ updated command symlink at $destination"
    fi
  elif [[ -e "$destination" ]]; then
    log "FATAL refusing to replace existing non-symlink command at $destination"
    log "remove or relocate it explicitly, then run 'whosaid install' again"
    exit 1
  else
    ln -s "$source" "$destination"
    log "✓ installed command at $destination"
  fi

  case ":${PATH:-}:" in
    *":$install_dir:"*) ;;
    *)
      log "NOTE add $install_dir to PATH to run 'whosaid' by name"
      ;;
  esac
}

# ---- doctor --------------------------------------------------------------------
cmd_doctor() {
  echo "whosaid doctor"
  echo "=============="

  local arch os_ver
  arch="$(uname -m)"
  os_ver="$(sw_vers -productVersion 2>/dev/null || echo unknown)"
  if [[ "$arch" == "arm64" ]]; then
    echo "✓ architecture: $arch (Apple Silicon) — macOS $os_ver"
  else
    echo "✗ architecture: $arch — whosaid requires Apple Silicon (arm64) for MLX/Metal"
  fi

  if command -v brew >/dev/null 2>&1; then
    echo "✓ Homebrew: $(brew --version 2>/dev/null | head -1)"
  else
    echo "✗ Homebrew not found — fix: install from https://brew.sh"
  fi

  if command -v ffmpeg >/dev/null 2>&1; then
    echo "✓ ffmpeg: $(ffmpeg -version 2>/dev/null | head -1)"
  else
    echo "✗ ffmpeg not found — fix: brew install ffmpeg"
  fi

  if command -v uv >/dev/null 2>&1; then
    echo "✓ uv: $(uv --version 2>/dev/null)"
  else
    echo "✗ uv not found — fix: brew install uv"
  fi

  local hf_home
  hf_home="${HF_HOME:-$HOME/.cache/huggingface}"
  if ls -d "$hf_home"/hub/models--mlx-community--whisper-large-v3-turbo* >/dev/null 2>&1; then
    echo "✓ Whisper model cached (turbo) under $hf_home/hub"
  else
    echo "✗ Whisper model not cached — fix: ./whosaid setup"
  fi

  local sherpa_cache
  sherpa_cache="${SHERPA_DIARIZE_CACHE:-$HOME/.cache/sherpa-diarization}"
  if [[ -f "$sherpa_cache/sherpa-onnx-pyannote-segmentation-3-0/model.onnx" ]]; then
    echo "✓ sherpa diarization models cached under $sherpa_cache"
  else
    echo "✗ sherpa diarization models not cached — fix: ./whosaid setup"
  fi

  local emb_name="${DIARIZE_EMB_NAME:-nemo_en_titanet_small.onnx}"
  if [[ -f "$sherpa_cache/$emb_name" ]]; then
    echo "✓ speaker-embedding model cached: $emb_name"
  else
    echo "✗ speaker-embedding model not cached ($emb_name) — fix: ./whosaid setup"
  fi

  local speaker_db="${WHOSAID_SPEAKER_DB:-$HOME/.config/whosaid/speakers.json}"
  if [[ -f "$speaker_db" ]]; then
    local nvoiceprints=""
    if command -v python3 >/dev/null 2>&1; then
      nvoiceprints="$(python3 -c 'import json,sys;print(len(json.load(open(sys.argv[1])).get("speakers",[])))' "$speaker_db" 2>/dev/null || echo '?')"
    else
      nvoiceprints="$(grep -c '"name"' "$speaker_db" 2>/dev/null || echo '?')"
    fi
    echo "✓ speaker registry: $speaker_db ($nvoiceprints voiceprint(s))"
  else
    echo "  speaker registry: none yet — name speakers with 'whosaid relabel' (default: $speaker_db)"
  fi

  local voices_found=0
  for f in "$VOICE_REFS"/*.wav; do
    [[ -f "$f" ]] || continue
    voices_found=$((voices_found + 1))
    echo "  voice: $(basename "${f%.wav}")"
  done
  if [[ "$voices_found" -eq 0 ]]; then
    echo "✗ no enrolled voices — fix: ./whosaid enroll"
  else
    echo "✓ $voices_found enrolled voice(s) in $VOICE_REFS"
  fi

  echo "--- avfoundation audio devices ---"
  ffmpeg -f avfoundation -list_devices true -i "" 2>&1 | awk '/AVFoundation audio devices:/{show=1} show' || true
}

# ---- enroll --------------------------------------------------------------------
RAINBOW_PASSAGE="When the sunlight strikes raindrops in the air, they act as a prism and form a rainbow. The rainbow is a division of white light into many beautiful colors. These take the shape of a long round arch, with its path high above, and its two ends apparently beyond the horizon. There is, according to legend, a boiling pot of gold at one end. People look, but no one ever finds it. When a man looks for something beyond his reach, his friends say he is looking for the pot of gold at the end of the rainbow."

cmd_enroll() {
  warn_if_not_arm64
  ensure_uv_and_ffmpeg

  local name="${1:-}"
  if [[ -z "$name" ]]; then
    read -r -p "whosaid: name for this voice (e.g. Alice): " name
  fi
  if [[ ! "$name" =~ ^[A-Za-z0-9_-]+$ ]]; then
    log "invalid name '$name' — use only letters, numbers, underscore, hyphen."
    exit 1
  fi

  mkdir -p "$VOICE_REFS"

  echo "============================================================================" >&2
  echo "$RAINBOW_PASSAGE" | fold -s -w 76 >&2
  echo "============================================================================" >&2
  echo "Press Enter to start recording; read the passage aloud at a normal pace." >&2
  echo "Recording stops automatically after 45s — or press Ctrl-C once you finish the paragraph." >&2
  read -r _ || true

  local tmpdir tmp
  tmpdir="$(mktemp -d -t whosaid-enroll)"
  tmp="$tmpdir/capture.m4a"
  trap 'rm -rf "$tmpdir"' EXIT

  log "recording... (up to 45s)"
  # Ctrl-C must stop ffmpeg (which finalizes the file) WITHOUT killing this
  # script — a no-op INT trap keeps bash alive so verification still runs.
  set +e
  trap ':' INT
  ffmpeg -hide_banner -loglevel warning -f avfoundation -i ":$REC_DEVICE" \
    -ac 1 -c:a aac -b:a 96k -t 45 -y "$tmp" </dev/null
  rc=$?
  trap - INT
  set -e
  if [[ "$rc" -ne 0 && "$rc" -ne 255 ]]; then
    log "ffmpeg exited with an unexpected error (code $rc)."
  fi

  if [[ ! -s "$tmp" ]]; then
    log "recording failed — no audio was captured (ffmpeg exit $rc)."
    exit 1
  fi

  local dur
  dur="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$tmp" 2>/dev/null || echo 0)"
  if ! awk -v d="$dur" 'BEGIN{exit !((d+0) >= 15)}'; then
    log "recording too short (${dur}s) — need at least 15s of speech. Try again and read the whole passage."
    exit 1
  fi

  local ffout meandb
  ffout="$(ffmpeg -hide_banner -i "$tmp" -af volumedetect -f null - 2>&1)" || true
  meandb=""
  if [[ "$ffout" =~ mean_volume:\ (-?[0-9.]+)\ dB ]]; then
    meandb="${BASH_REMATCH[1]}"
  fi
  if [[ -n "$meandb" ]] && awk -v m="$meandb" 'BEGIN{exit !((m+0) <= -85)}'; then
    log "recording is SILENT (mean volume ${meandb} dB)."
    log "macOS denies an unauthorized app's microphone by feeding it silent zeros — no error is raised."
    log "Fix: System Settings -> Privacy & Security -> Microphone -> enable your terminal app, then re-run 'whosaid enroll'."
    exit 1
  fi

  local dest="$VOICE_REFS/$name.wav"
  ffmpeg -hide_banner -loglevel warning -y -i "$tmp" -ac 1 -ar 16000 "$dest"

  log "✓ enrolled '$name' -> $dest"
  log "future transcripts will label this voice '$name'."
}

# ---- record --------------------------------------------------------------------
cmd_record() {
  warn_if_not_arm64
  ensure_uv_and_ffmpeg

  local label=""
  local extra_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --label) label="$2"; shift 2 ;;
      *) extra_args+=("$1"); shift ;;
    esac
  done

  mkdir -p "$RECORDINGS_DIR"
  local ts out
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  if [[ -n "$label" ]]; then
    local slug
    slug="$(printf '%s' "$label" | tr -c 'A-Za-z0-9_-' '-')"
    out="$RECORDINGS_DIR/${ts}-${slug}.m4a"
  else
    out="$RECORDINGS_DIR/${ts}.m4a"
  fi

  log "recording to $out — press Ctrl-C to stop (auto-stops after 3h)."
  # Ctrl-C must stop ffmpeg (which finalizes the m4a) WITHOUT killing this
  # script — a no-op INT trap keeps bash alive so verify + transcribe still run.
  set +e
  trap ':' INT
  ffmpeg -hide_banner -loglevel warning -f avfoundation -i ":$REC_DEVICE" \
    -ac 1 -c:a aac -b:a 96k -t 10800 -y "$out" </dev/null
  rc=$?
  trap - INT
  set -e
  if [[ "$rc" -ne 0 && "$rc" -ne 255 ]]; then
    log "ffmpeg exited with an unexpected error (code $rc)."
  fi

  if [[ ! -s "$out" ]]; then
    log "recording failed — no audio was captured (ffmpeg exit $rc)."
    exit 1
  fi

  local dur
  dur="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$out" 2>/dev/null || echo "?")"
  log "captured ${dur}s -> $out"

  local ffout meandb
  ffout="$(ffmpeg -hide_banner -i "$out" -af volumedetect -f null - 2>&1)" || true
  meandb=""
  if [[ "$ffout" =~ mean_volume:\ (-?[0-9.]+)\ dB ]]; then
    meandb="${BASH_REMATCH[1]}"
  fi
  if [[ -n "$meandb" ]] && awk -v m="$meandb" 'BEGIN{exit !((m+0) <= -85)}'; then
    log "recording saved at $out but it is SILENT (mean volume ${meandb} dB)."
    log "macOS denies an unauthorized app's microphone by feeding it silent zeros — no error is raised."
    log "Fix: System Settings -> Privacy & Security -> Microphone -> enable your terminal app, then re-run."
    exit 4
  fi

  # ${arr[@]+...} guard: expanding an EMPTY array errs under set -u on bash 3.2
  # (macOS system bash), which would crash a plain `whosaid record`.
  cmd_transcribe "$out" ${extra_args[@]+"${extra_args[@]}"}
}

# ---- transcribe (default flow) --------------------------------------------------
cmd_transcribe() {
  [[ -f "$HELPER" ]] || { log "helper not found at $HELPER"; exit 1; }

  local MODEL="${WHOSAID_MODEL:-mlx-community/whisper-large-v3-turbo}"
  local LANG_CODE="$LANG_CODE_DEFAULT"
  local FORMAT="all"
  local OUTDIR=""
  local NAME=""
  local DIARIZE=1
  local SPEAKERS=""
  local JOBS=""
  local CHUNK_SECONDS=""
  local NO_CHUNK=0
  local ABSORB=""
  local MATCH_THRESHOLD=""
  local AUDIO=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--outdir)  OUTDIR="$2"; shift 2 ;;
      -m|--model)   MODEL="$2"; shift 2 ;;
      --accurate)   MODEL="mlx-community/whisper-large-v3-mlx"; shift ;;
      -l|--lang)    LANG_CODE="$2"; shift 2 ;;
      -f|--format)  FORMAT="$2"; shift 2 ;;
      -n|--name)    NAME="$2"; shift 2 ;;
      --no-diarize) DIARIZE=0; shift ;;
      --diarize)    DIARIZE=1; shift ;;
      --speakers)   SPEAKERS="$2"; shift 2 ;;
      -j|--jobs)    JOBS="$2"; shift 2 ;;
      --chunk-seconds) CHUNK_SECONDS="$2"; shift 2 ;;
      --absorb-threshold) ABSORB="$2"; shift 2 ;;
      --match-threshold|--ref-threshold) MATCH_THRESHOLD="$2"; shift 2 ;;
      --no-chunk)   NO_CHUNK=1; shift ;;
      -h|--help)    cmd_help; exit 0 ;;
      --)           shift; while [[ $# -gt 0 ]]; do AUDIO+=("$1"); shift; done ;;
      -*)           log "unknown option: $1"; cmd_help; exit 1 ;;
      *)            AUDIO+=("$1"); shift ;;
    esac
  done

  [[ ${#AUDIO[@]} -eq 0 ]] && { log "no audio file given."; cmd_help; exit 1; }
  [[ -n "$NAME" && ${#AUDIO[@]} -gt 1 ]] && { log "--name only works with a single input."; exit 1; }

  warn_if_not_arm64
  ensure_uv_and_ffmpeg

  log "model=$MODEL  lang=$LANG_CODE  format=$FORMAT  diarize=$DIARIZE  (GPU/Metal via MLX)"
  SECONDS=0
  for audio in "${AUDIO[@]}"; do
    [[ -f "$audio" ]] || { log "file not found: $audio"; exit 1; }
    local out="${OUTDIR:-$(dirname "$audio")}"
    mkdir -p "$out"
    local dur
    dur="$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$audio" 2>/dev/null || echo "?")"
    log "→ $audio  (${dur}s)  →  $out/"

    # Derive a dot-safe output base. mlx-whisper's writer runs its own
    # os.path.splitext on the base, so any '.' in the name (e.g. "v1.2") would
    # truncate every output file. Map anything but [A-Za-z0-9_-] to '_' and pass
    # this base explicitly so the CLI and both helpers agree on the filenames.
    local base="${NAME:-$(basename "${audio%.*}")}"
    base="$(printf '%s' "$base" | tr -c 'A-Za-z0-9_-' '_')"

    local helper_args=("$audio" --model "$MODEL" --outdir "$out" --lang "$LANG_CODE" --format "$FORMAT" --name "$base")

    uv run --quiet --with mlx-whisper python "$HELPER" "${helper_args[@]}"

    local txt="$out/$base.txt"
    if [[ ! -s "$txt" ]]; then
      log "ERROR expected transcript not found or empty: $txt"
      exit 1
    fi
    log "✓ $txt"
    echo "----- first lines -----" >&2
    head -c 600 "$txt" >&2; echo >&2

    # --- speaker diarization (local; never fatal to the transcript) -------------
    # Only the .json output feeds the diarizer merge, so this whole block — and the
    # exit-3 gate below — only applies when --format actually produced one.
    if [[ "$DIARIZE" == "1" && -f "$out/$base.json" ]]; then
      if [[ -f "$DIARIZER" ]]; then
        local dargs=("$audio" --whisper-json "$out/$base.json" --outdir "$out" --name "$base")
        [[ -n "$SPEAKERS" ]] && dargs+=(--num-speakers "$SPEAKERS")
        [[ -n "$JOBS" ]] && dargs+=(--jobs "$JOBS")
        [[ -n "$CHUNK_SECONDS" ]] && dargs+=(--chunk-seconds "$CHUNK_SECONDS")
        [[ "$NO_CHUNK" == "1" ]] && dargs+=(--no-chunk)
        [[ -n "$ABSORB" ]] && dargs+=(--absorb-threshold "$ABSORB")
        [[ -n "$MATCH_THRESHOLD" ]] && dargs+=(--ref-threshold "$MATCH_THRESHOLD")
        if [[ -d "$VOICE_REFS" ]]; then
          for ref in "$VOICE_REFS"/*.wav "$VOICE_REFS"/*.m4a; do
            [[ -f "$ref" ]] || continue
            local refname
            refname="$(basename "${ref%.*}")"
            dargs+=(--ref "$refname=$ref")
          done
        fi
        if uv run --quiet --with sherpa-onnx --with numpy python "$DIARIZER" "${dargs[@]}"; then
          :
        else
          log "WARN diarization failed; plain transcript is unaffected."
        fi
      else
        log "WARN diarizer script not found at $DIARIZER; skipping diarization for $audio."
      fi

      local speakers_txt="$out/$base.speakers.txt"
      if [[ ! -s "$speakers_txt" ]]; then
        log "plain transcript saved at $txt; diarization failed (see warnings above)"
        exit 3
      fi
      log "✓ $speakers_txt (speaker-labeled)"
    elif [[ "$DIARIZE" == "1" ]]; then
      log "WARN Whisper json output not found (format=$FORMAT); skipping diarization for $audio."
    fi
  done
  log "done in ${SECONDS}s."
}

# ---- relabel -----------------------------------------------------------------
# After reading the speaker cards, put real names on clusters and remember them.
#   whosaid relabel <base|sidecar.diarization.json> SPEAKER_02=Jane SPEAKER_03=Bob [-o DIR]
# Applies names to the cached diarization sidecar (no re-transcription), persists
# each named voiceprint to the local registry (~/.config/whosaid/speakers.json by
# default) so the person is auto-named in future transcripts, and rewrites the
# speaker-labeled transcript + cards.
cmd_relabel() {
  local target="" outdir="" auto=0 specs=() extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--outdir) outdir="$2"; shift 2 ;;
      --auto)      auto=1; shift ;;
      --absorb-threshold) extra+=(--absorb-threshold "$2"); shift 2 ;;
      --ref-threshold|--match-threshold) extra+=(--ref-threshold "$2"); shift 2 ;;
      *=*)         specs+=(--save-speaker "$1"); shift ;;
      *)           if [[ -z "$target" ]]; then target="$1"; else log "relabel: unexpected arg '$1'"; exit 1; fi; shift ;;
    esac
  done
  [[ -z "$target" ]] && { log "relabel: need a base name or sidecar path. e.g. whosaid relabel meeting SPEAKER_02=Jane (or --auto)"; exit 1; }
  if [[ ${#specs[@]} -eq 0 && "$auto" -eq 0 ]]; then
    log "relabel: need at least one SPEAKER_XX=Name assignment, or --auto to re-apply registry + absorb naming"; exit 1
  fi

  # Resolve the sidecar path.
  local sidecar=""
  if [[ -f "$target" ]]; then
    sidecar="$target"
  elif [[ -f "$target.diarization.json" ]]; then
    sidecar="$target.diarization.json"
  elif [[ -n "$outdir" && -f "$outdir/$target.diarization.json" ]]; then
    sidecar="$outdir/$target.diarization.json"
  else
    log "relabel: could not find a diarization sidecar for '$target'"
    log "  looked for: $target, ./$target.diarization.json${outdir:+, $outdir/$target.diarization.json}"
    exit 1
  fi
  local sdir; sdir="$(cd -P "$(dirname "$sidecar")" && pwd)"
  log "relabel: using sidecar $sidecar"
  [[ "$auto" -eq 1 ]] && extra+=(--auto)
  uv run --quiet --with sherpa-onnx --with numpy python "$DIARIZER" \
    --relabel "$sidecar" --outdir "$sdir" ${specs[@]+"${specs[@]}"} ${extra[@]+"${extra[@]}"}
}

# ---- ingest / roll-up (issue #2: meeting workspace) ----------------------------
# whosaid ingest <audio...> --into DIR [--folder-by created|mtime] [--tz ZONE]
#                [--action-items] [--hook CMD] [transcribe flags...]
# Transcribe each file into <into>/<YYYY-MM-DD-HHMM>/ with base name "transcript"
# and keep the source audio beside it so roll-up's audit can hash it. Idempotent:
# a file whose sha256 already appears in <into>/_workspace.json (written by
# roll-up) is skipped BEFORE any transcription. Folder naming, hashing, and
# action items live in lib/workspace.py (stdlib-only; plain python3 runs it).
cmd_ingest() {
  local into="" folder_by="created" tz_arg="" want_action_items=0 hook=""
  local passthrough=() AUDIO=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --into)         into="$2"; shift 2 ;;
      --folder-by)    folder_by="$2"; shift 2 ;;
      --tz)           tz_arg="$2"; shift 2 ;;
      --action-items) want_action_items=1; shift ;;
      --hook)         hook="$2"; shift 2 ;;
      # ingest owns the output layout and base name
      -o|--outdir) log "ingest: -o/--outdir is not allowed — ingest places each meeting itself"; exit 1 ;;
      -n|--name)   log "ingest: -n/--name is not allowed — ingest names its outputs 'transcript'"; exit 1 ;;
      # transcribe flags that pass straight through
      -m|--model|-l|--lang|-f|--format|--speakers|-j|--jobs|--chunk-seconds|--absorb-threshold|--match-threshold|--ref-threshold)
                      passthrough+=("$1" "$2"); shift 2 ;;
      --accurate|--diarize|--no-diarize|--no-chunk)
                      passthrough+=("$1"); shift ;;
      --)            shift; while [[ $# -gt 0 ]]; do AUDIO+=("$1"); shift; done ;;
      -h|--help)     cmd_help; exit 0 ;;
      -*)            log "unknown option: $1"; cmd_help; exit 1 ;;
      *)             AUDIO+=("$1"); shift ;;
    esac
  done

  [[ -z "$into" ]] && { log "ingest: --into DIR is required (the meeting workspace root)"; exit 1; }
  [[ ${#AUDIO[@]} -eq 0 ]] && { log "no audio file given."; cmd_help; exit 1; }
  case "$folder_by" in
    created|mtime) ;;
    *) log "ingest: --folder-by must be 'created' or 'mtime' (got '$folder_by')"; exit 1 ;;
  esac

  mkdir -p "$into"

  # Local zone for the dated folder name: explicit --tz wins, else the system's
  # IANA zone from /etc/localtime; if neither resolves, leave --tz off and let
  # workspace.py default to UTC.
  local tz=""
  if [[ -n "$tz_arg" ]]; then
    tz="$tz_arg"
  else
    local localtime_link=""
    localtime_link="$(readlink /etc/localtime 2>/dev/null || true)"
    if [[ "$localtime_link" == *zoneinfo/* ]]; then
      tz="${localtime_link##*zoneinfo/}"
    else
      log "NOTE could not detect the local timezone; folder names default to UTC (pass --tz ZONE to override)"
    fi
  fi
  if [[ -n "$tz" ]]; then
    python3 -c 'import sys; from zoneinfo import ZoneInfo; ZoneInfo(sys.argv[1])' "$tz" 2>/dev/null \
      || { log "ingest: unknown timezone '$tz'"; exit 1; }
  fi

  local audio sha existing fname
  for audio in "${AUDIO[@]}"; do
    [[ -f "$audio" ]] || { log "file not found: $audio"; exit 1; }

    # identity + idempotence: skip BEFORE any transcription work
    sha="$(python3 "$REPO_DIR/lib/workspace.py" hash "$audio")" \
      || { log "ingest: hash failed for $audio"; exit 1; }
    existing="$(python3 -c '
import json, sys
sha, manifest = sys.argv[1], sys.argv[2]
try:
    meetings = json.load(open(manifest)).get("meetings", [])
except Exception:
    sys.exit(0)
for m in meetings:
    if isinstance(m, dict) and m.get("source_sha256") == sha:
        print(m.get("folder", ""))
        break
' "$sha" "$into/_workspace.json")"
    if [[ -n "$existing" ]]; then
      log "already ingested as $existing (skipping) — $audio"
      continue
    fi

    # dated folder name
    if [[ "$folder_by" == "mtime" ]]; then
      # workspace.py's folder-name always prefers the creation_time tag, so the
      # mtime mode is computed here from the filesystem stamp directly.
      local epoch date_tz="$tz"
      [[ -z "$date_tz" ]] && date_tz="UTC"
      epoch="$(stat -f %m "$audio")"
      fname="$(TZ="$date_tz" date -r "$epoch" +%Y-%m-%d-%H%M)"
    else
      local fn_args=(folder-name "$audio")
      if [[ -n "$tz" ]]; then fn_args+=(--tz "$tz"); fi
      fname="$(python3 "$REPO_DIR/lib/workspace.py" "${fn_args[@]}")" \
        || { log "ingest: could not derive a folder name for $audio"; exit 1; }
    fi

    # a same-named folder already holding another meeting gets -2, -3, ... suffixes
    local base_fname="$fname" n=2
    while [[ -d "$into/$fname" ]] && [[ -n "$(ls -A "$into/$fname")" ]]; do
      fname="$base_fname-$n"
      n=$((n + 1))
    done
    [[ "$fname" != "$base_fname" ]] && log "folder $base_fname already occupied; using $fname"

    local folder="$into/$fname"
    mkdir -p "$folder"
    log "→ $audio  →  $folder/"

    # WHOSAID_INGEST_DRYRUN (undocumented test hook): skip the model call but
    # leave a stub transcript so the rest of the ingest plumbing can be checked.
    if [[ -n "${WHOSAID_INGEST_DRYRUN:-}" ]]; then
      log "(dryrun) transcription skipped; would run: transcribe $audio -o $folder -n transcript"
      printf '[dryrun stub transcript]\n' > "$folder/transcript.txt"
    else
      # Subshell: cmd_transcribe signals "transcript ok, diarization failed"
      # with exit 3 — that must warn here, not abort the ingest loop.
      local rc=0
      ( cmd_transcribe "$audio" -o "$folder" -n transcript ${passthrough[@]+"${passthrough[@]}"} ) || rc=$?
      if [[ "$rc" -ne 0 ]]; then
        if [[ "$rc" -eq 3 ]]; then
          log "WARN diarization incomplete for $fname; plain transcript stands"
        else
          log "ERROR transcription failed (exit $rc): $audio"
          exit "$rc"
        fi
      fi
    fi

    # keep the source beside the transcript so roll-up's audit can hash it
    local copied=1
    cp -n "$audio" "$folder/" || { copied=0; log "WARN source copy skipped for $fname"; }

    # upsert a minimal manifest entry so ingest alone is idempotent: without it an
    # immediate re-ingest (no roll-up in between) sees no sha in _workspace.json
    # and duplicates the meeting into a -2 folder. roll-up's scan_meeting keeps
    # ingested_at and recomputes every other field from the folder contents.
    if [[ "$copied" == "1" ]]; then
      python3 -c '
import json, os, sys, tempfile
from datetime import datetime, timezone

path, folder, src, sha = sys.argv[1:5]
try:
    with open(path) as f:
        data = json.load(f)
    if not (isinstance(data, dict) and isinstance(data.get("meetings"), list)):
        raise ValueError("unexpected manifest shape")
except Exception:
    data = {"meetings": []}
data["meetings"] = [
    m for m in data["meetings"]
    if not (isinstance(m, dict) and m.get("folder") == folder)
]
data["meetings"].append({
    "folder": folder,
    "source_name": src,
    "source_sha256": sha,
    "ingested_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
})
d = os.path.dirname(path) or "."
fd, tmp = tempfile.mkstemp(dir=d, prefix=".workspace-", suffix=".tmp")
try:
    with os.fdopen(fd, "w") as f:
        f.write(json.dumps(data, indent=2) + "\n")
    os.replace(tmp, path)
except BaseException:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    raise
' "$into/_workspace.json" "$fname" "$(basename "$audio")" "$sha" \
        || log "WARN could not update manifest; roll-up will rebuild it"
    fi

    if [[ "$want_action_items" == "1" ]]; then
      local transcript="$folder/transcript.speakers.txt"
      if [[ ! -s "$transcript" ]]; then
        transcript="$folder/transcript.txt"
        log "NOTE no speaker-labeled transcript in $fname; using the plain transcript for action items"
      fi
      if [[ -s "$transcript" ]]; then
        local ai_args=(action-items --transcript "$transcript" --json-out "$folder/action-items.json")
        if [[ -n "$hook" ]]; then ai_args+=(--hook "$hook"); fi
        python3 "$REPO_DIR/lib/workspace.py" "${ai_args[@]}" \
          || log "WARN action items failed for $fname (continuing)"
      else
        log "WARN no transcript found in $fname; skipping action items"
      fi
    fi
    log "✓ ingested $fname/"
  done

  log "next: whosaid roll-up $into --action-items"
}

# whosaid roll-up <workspace-dir> [--action-items] [-o OUT] [--action-items-out OUT]
#                 [--similarity-threshold F] [--rebuild]
# Thin bash front for `python3 lib/workspace.py rollup`: rebuilds _INDEX.md, the
# _workspace.json manifest, and (with --action-items) the deduplicated corpus.
cmd_rollup() {
  local wsdir="" py_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --action-items)     py_args+=("$1"); shift ;;
      --rebuild)          py_args+=("$1"); shift ;;
      -o|--out)           py_args+=("$1" "$2"); shift 2 ;;
      --action-items-out) py_args+=("$1" "$2"); shift 2 ;;
      --similarity-threshold) py_args+=("$1" "$2"); shift 2 ;;
      -h|--help)          cmd_help; exit 0 ;;
      -*)                 log "unknown option: $1"; cmd_help; exit 1 ;;
      *)                  if [[ -z "$wsdir" ]]; then wsdir="$1"; else log "roll-up: unexpected arg '$1'"; exit 1; fi; shift ;;
    esac
  done
  [[ -z "$wsdir" ]] && { log "roll-up: need a workspace directory. e.g. whosaid roll-up meetings/"; exit 1; }
  exec python3 "$REPO_DIR/lib/workspace.py" rollup "$wsdir" ${py_args[@]+"${py_args[@]}"}
}

# ---- dispatch --------------------------------------------------------------------
case "${1:-}" in
  setup)
    exec "$REPO_DIR/bootstrap.sh" "${@:2}"
    ;;
  install)
    cmd_install
    ;;
  enroll)
    cmd_enroll "${@:2}"
    ;;
  record)
    cmd_record "${@:2}"
    ;;
  relabel)
    cmd_relabel "${@:2}"
    ;;
  ingest)
    cmd_ingest "${@:2}"
    ;;
  roll-up|rollup)
    cmd_rollup "${@:2}"
    ;;
  doctor)
    cmd_doctor
    ;;
  mcp)
    # Pin to the tested SDK major: mcp 2.x uses MCPServer; a future 3.0 could
    # break the API, so cap it rather than silently pull an untested major.
    exec uv run --quiet --with "mcp[cli]>=2,<3" python "$REPO_DIR/lib/mcp_server.py"
    ;;
  help|-h|--help|"")
    cmd_help
    ;;
  *)
    cmd_transcribe "$@"
    ;;
esac
