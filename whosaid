#!/usr/bin/env bash
# ==============================================================================
# whosaid — local, GPU-accelerated, speaker-attributed transcription (Apple Silicon)
#
# Usage:
#   whosaid setup                 Run bootstrap.sh (deps, models, disk check).
#   whosaid install               Install a stable command in ~/.local/bin.
#   whosaid enroll [Name]         Record a voice sample and name a speaker cluster.
#   whosaid record [--label L]    Record from the mic, then transcribe it.
#   whosaid doctor                Read-only environment/model/device report.
#   whosaid version | --version   Print the installed version.
#   whosaid mcp                   Run the MCP server (stdio) for AI agents / Claude.
#   whosaid <audio> [...]         Transcribe (and, by default, diarize) audio file(s).
#   whosaid ingest <a...> --into D  Transcribe into a dated meeting workspace.
#   whosaid roll-up <dir>           Rebuild the meeting-workspace index and audit.
#   whosaid index <ws>              Build the workspace search index, graph, and wiki.
#   whosaid search <ws> "<q>"       Exact / meaning / hybrid search over every transcript.
#   whosaid context <ws> <mtg> <t>  Verbatim turns around a timestamp.
#   whosaid graph <ws> <view>       items | item ID | person [Name] | prs | meetings | speakers | commitments.
#   whosaid wiki <ws>               Regenerate <ws>/_WIKI.md from the graph.
#   whosaid watch <sub>             run | install | uninstall | status: hands-free ingest (launchd).
#   whosaid memos <sub>             list | pull | delete | shortcut-recipe: Voice Memos helpers.
#   whosaid help                  This message.
#
# See `whosaid help` for the full flag reference.
# ==============================================================================
set -euo pipefail

# Make Homebrew tools (ffmpeg, uv) visible even under a minimal PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Follow symlinks so an installed ~/.local/bin/whosaid command still finds the
# implementation and model helpers in this checkout.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$SOURCE_DIR/$SOURCE"
done
REPO_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

# Single source of truth for the released version. Bump this alongside the
# CHANGELOG.md entry and git tag at release time.
WHOSAID_VERSION="1.3.0"

HELPER="$REPO_DIR/lib/transcribe_mlx.py"
DIARIZER="$REPO_DIR/lib/diarize_sherpa.py"
VOICE_REFS="${WHOSAID_VOICE_REFS:-$REPO_DIR/voices}"
RECORDINGS_DIR="$REPO_DIR/recordings"
LANG_CODE_DEFAULT="${WHOSAID_LANG:-en}"
REC_DEVICE="${WHOSAID_REC_DEVICE:-0}"

log() { echo "whosaid: $*" >&2; }

# ---- temp-directory checkout guard --------------------------------------------
# True (0) when the resolved path is under a system temp directory: /tmp,
# /private/tmp, /var/tmp, /private/var/tmp, or the resolved $TMPDIR (macOS's
# per-user/per-process temp dir, e.g. /var/folders/.../T/). A checkout there
# gets purged by the OS, leaving `whosaid install`'s symlink dangling with no
# diagnostic pointing at the real cause — see `cmd_install`, `cmd_doctor`, and
# GitHub issue #10.
is_temp_path() {
  local target="$1"
  local resolved
  resolved="$(cd -P "$target" 2>/dev/null && pwd)" || resolved="$target"
  local roots=(/tmp /private/tmp /var/tmp /private/var/tmp)
  if [[ -n "${TMPDIR:-}" ]]; then
    local resolved_tmpdir
    resolved_tmpdir="$(cd -P "$TMPDIR" 2>/dev/null && pwd)" || resolved_tmpdir="${TMPDIR%/}"
    roots+=("$resolved_tmpdir")
  fi
  local root
  for root in "${roots[@]}"; do
    root="${root%/}"
    [[ -z "$root" ]] && continue
    if [[ "$resolved" == "$root" || "$resolved" == "$root"/* ]]; then
      return 0
    fi
  done
  return 1
}

# ---- shared environment guards (mirrors the transcribe flow's own checks) --
warn_if_not_arm64() {
  if [[ "$(uname -m)" != "arm64" ]]; then
    log "WARNING — MLX is Apple-Silicon only; on $(uname -m) this will be slow or fail."
  fi
}

ensure_uv_and_ffmpeg() {
  if ! command -v uv >/dev/null 2>&1; then
    log "'uv' not found. Installing via Homebrew..."
    command -v brew >/dev/null 2>&1 || { log "Homebrew required to bootstrap uv. See https://brew.sh"; exit 1; }
    brew install uv
  fi
  if ! command -v ffmpeg >/dev/null 2>&1; then
    log "'ffmpeg' not found (needed to decode/capture audio). Installing via Homebrew..."
    command -v brew >/dev/null 2>&1 || { log "Homebrew required to bootstrap ffmpeg. See https://brew.sh"; exit 1; }
    brew install ffmpeg
  fi
}

